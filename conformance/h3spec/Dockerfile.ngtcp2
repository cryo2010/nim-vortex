# The vortex HTTP/3 server built on the ngtcp2/nghttp3 backend (-d:quicNgtcp2)
# for the h3spec conformance run. Selected by `NGTCP2=1 sh conformance/h3spec/run.sh`.
# Based on the deps image (Nim + ngtcp2 + nghttp3 ossl backend); run.sh builds it.

FROM vortex-ngtcp2-deps
WORKDIR /vortex
COPY src ./src
COPY conformance/h3spec/h3spec_server.nim ./h3spec_server.nim
RUN nim c --mm:orc --threads:on -d:release -d:quicNgtcp2 -d:ssl -p:src \
      -o:h3spec_server h3spec_server.nim

RUN openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -keyout key.pem -out cert.pem \
      -subj "/CN=localhost" \
      -addext "subjectAltName=DNS:server,DNS:localhost"

EXPOSE 4433/udp
CMD ["./h3spec_server"]
