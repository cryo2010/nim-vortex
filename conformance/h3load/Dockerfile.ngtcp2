# The vortex HTTP/3 server built on the ngtcp2/nghttp3 backend (-d:quicNgtcp2),
# for the h3load throughput comparison against the OpenSSL-QUIC build (Dockerfile).
# Selected by `NGTCP2=1 sh conformance/h3load/run.sh`. Based on the deps image
# (Nim + ngtcp2 + nghttp3 ossl backend); run.sh builds that first.

FROM vortex-ngtcp2-deps
WORKDIR /vortex
COPY src ./src
COPY conformance/h3load/h3load_server.nim ./h3load_server.nim
RUN nim c --mm:orc --threads:on -d:release -d:quicNgtcp2 -d:ssl -p:src \
      -o:h3load_server h3load_server.nim

# Throwaway self-signed cert at the paths h3load_server.nim expects (/vortex).
RUN openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -keyout key.pem -out cert.pem \
      -subj "/CN=localhost" \
      -addext "subjectAltName=DNS:server,DNS:localhost"

EXPOSE 4433/udp
CMD ["./h3load_server"]
